rules_version = '2';

// 블로그 보호 규칙 — Firebase 콘솔 [Firestore Database → 규칙]에 그대로 붙여 넣고 [게시]합니다.
// 관리자 UID는 firebase-config.js의 ADMIN_UID·EXTRA_ADMIN_UIDS와 같아야 합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 주 관리자(구글) + 평가용 테스트 계정(이메일) — 둘 다 같은 권한. 제출이 끝나면 테스트 계정 UID를 지웁니다
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['5O7QPzPsnLUSRNf9fefKpNEYayW2', 'fjM3ZB81EVgnLFXxcW44YX9k9ZU2'];
    }

    // 방문자에게 보여도 되는 글: 공개로 발행된 글
    function isPublic(post) {
      return post.status == 'published' && post.visibility == 'public';
    }

    function validPost() {
      let p = request.resource.data;
      return p.status in ['draft', 'published']
        && p.visibility in ['public', 'private']
        && p.title is string && p.body is string
        && p.tags is list && p.tags.size() <= 20
        && (!('cover' in p) || p.cover == ''
            || (p.cover is string && p.cover.size() < 750000 && p.cover.matches('^data:image/jpeg;base64,.*')))
        && (!('images' in p) || (p.images is map && p.images.size() <= 20))
        && (p.status == 'draft'
            || (p.title.size() > 0 && p.body.size() > 0
                && p.category in ['plan', 'design', 'retro']));
    }

    // 좋아요: 누구나 likes 숫자만 1씩 올리거나 내릴 수 있음
    function validLike() {
      let before = resource.data.get('likes', 0);
      let after = request.resource.data.likes;
      return isPublic(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && after is int && after >= 0
        && (after == before + 1 || after == before - 1);
    }

    match /posts/{postId} {
      allow read: if isAdmin() || isPublic(resource.data);
      allow create: if isAdmin() && validPost();
      allow update: if (isAdmin() && validPost()) || validLike();
      allow delete: if isAdmin();

      // 댓글: 공개 글에 누구나 작성, 삭제는 관리자만
      match /comments/{commentId} {
        function parent() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }
        allow read: if isAdmin() || isPublic(parent());
        allow create: if (isAdmin() || isPublic(parent()))
          && request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin();
      }
    }

    // 조회수: 공개 글을 열 때 누구나 그날 숫자와 전체 숫자를 1씩만 올릴 수 있음, 보기는 관리자만
    match /views/{postId} {
      function postIsPublic() {
        return isPublic(get(/databases/$(database)/documents/posts/$(postId)).data);
      }
      function validDay(d) {
        return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      allow read, delete: if isAdmin();
      allow create: if postIsPublic()
        && request.resource.data.keys().hasOnly(['total', 'last', 'days'])
        && request.resource.data.total == 1
        && validDay(request.resource.data.last)
        && request.resource.data.days is map
        && request.resource.data.days.keys().hasOnly([request.resource.data.last])
        && request.resource.data.days[request.resource.data.last] == 1;
      allow update: if postIsPublic()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total', 'last', 'days'])
        && request.resource.data.total == resource.data.total + 1
        && validDay(request.resource.data.last)
        && request.resource.data.days.diff(resource.data.days).affectedKeys().hasOnly([request.resource.data.last])
        && request.resource.data.days[request.resource.data.last] == resource.data.days.get(request.resource.data.last, 0) + 1;
    }

    // 구독 신청: 누구나 신청만 가능 (같은 주소는 한 번만), 목록은 관리자만 봄
    match /subscribers/{email} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == email
        && email.size() < 200
        && email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
